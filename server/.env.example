PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/freshfold
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_ORIGINS=http://localhost:5173
# Production: replace this with your exact HTTPS frontend origin(s), comma-separated.
# Set NODE_ENV=production in your hosting dashboard; never commit the real .env file.
NODE_ENV=development
TRUST_PROXY=false
# Email OTP via Gmail SMTP (use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-freshfold-sender@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=FreshFold <your-freshfold-sender@gmail.com>
# If SMTP credentials are blank, demo OTP is returned only outside production. Production startup requires SMTP credentials.

# Razorpay Test Mode keys (get these from Razorpay Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
